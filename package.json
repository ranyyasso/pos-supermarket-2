    "@vitejs/plugin-react": "5.0.4",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "^4.1.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pg": "^8.23.0",
